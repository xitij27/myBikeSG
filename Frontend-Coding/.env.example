# Copy to .env.local (git-ignored) and fill in.

# Google Maps JavaScript API key (https://developers.google.com/maps/documentation/javascript/get-api-key).
# Restrict it to your site's domain in the Google Cloud console.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Base URL of the backend in Backend-Coding (default http://localhost:9000).
# REACT_APP_API_URL=http://localhost:9000
