# Copy to .env (git-ignored) and fill in.

# MongoDB connection string, e.g. from MongoDB Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Mail account that sends the one-time passwords (nodemailer).
EMAIL_SERVICE=outlook
EMAIL_USER=you@example.com
EMAIL_PASS=your-mail-password

# Port the API listens on (default 9000).
# PORT=9000
